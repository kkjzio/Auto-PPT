# 配置文件示例 | Configuration file example
# 复制此文件为 .env 并填入真实的配置值 | Copy this file to .env and fill in real values

# 真正的秘钥文件 方便仓库所有者管理 | The real key file is convenient for warehouse owners to manage
REAL_FILE=config.ini

# OpenAI 代理方案 | OpenAI proxy solution
# 如果不需要可以不修改 https://github.com/chatanywhere/GPT_API_free
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 你的 OpenAI 接口秘钥 | Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 模型名称 | OpenAI model name
OPENAI_MODEL_NAME=Qwen/Qwen3-32B

# 你的 Unsplash 使用开关 | Switch for using Unsplash
UNSPLASH_ENABLE=false

# 你的 Unsplash 接口秘钥 | Your Unsplash API key
# 使用','进行分割 | Use ',' for separation
UNSPLASH_API_KEY=key1,key2,key3,key4

# 使用 Redis 来缓存上下文 | Use Redis to cache the context
REDIS_ENABLE=true

# Redis URL | Redis URL
REDIS_URL=redis://127.0.0.1:6379

# Redis 密码 | Redis password (可选，如果没有密码可以留空)
REDIS_PASSWORD=your_redis_password_here